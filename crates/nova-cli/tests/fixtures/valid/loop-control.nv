fn main() -> Int {
    var index = 0;
    var sum = 0;

    while index < 8 {
        index = index + 1;
        if index == 3 { continue; } else { 0 };
        if index == 6 { break; } else { 0 };
        sum = sum + index;
    }

    var outer = 0;
    while outer < 3 {
        outer = outer + 1;
        while true {
            sum = sum + 10;
            break;
        }
    }

    sum
}
